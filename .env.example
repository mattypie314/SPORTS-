# mlbkalshi — books-first scanner (paper default)
# BANKROLL=100
# SMALL_BANKROLL=1
# BOOK_LINES_PATH=data/books.json
# MLBKALSHI_DATA=data
# LIVE_TRADING=0

# Optional: The Odds API key for sportsbook comparison signals
# https://the-odds-api.com
ODDS_API_KEY=

# Paper trading bankroll and risk (defaults shown)
SPORTSBOT_BANKROLL=1000
SPORTSBOT_MAX_TRADE_USD=25
SPORTSBOT_MAX_DAILY_USD=200
SPORTSBOT_MAX_OPEN_POSITIONS=8
SPORTSBOT_MIN_EDGE=0.02

# Live Kalshi trading is OFF unless all of these are set.
# Market data always uses production. Live orders use KALSHI_ENV.
KALSHI_ENABLE_LIVE=false
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
